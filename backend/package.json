{
  "name": "catfe-backend",
  "version": "1.0.0",
  "description": "API REST de Catfé con Node.js, Express y MongoDB",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node seed.js",
    "seed:pruebas": "node --env-file=.env.pruebas seed.js",
    "probar": "node --env-file=.env.pruebas pruebas/probarFlujo.js",
    "probar:fallo": "node --env-file=.env.pruebas pruebas/probarFlujo.js --simular-fallo",
    "probar:corte": "node --env-file=.env.pruebas pruebas/probarFlujo.js --simular-corte-limpieza",
    "probar:limpiar": "node --env-file=.env.pruebas pruebas/probarFlujo.js --limpiar",
    "probar:transacciones": "node --env-file=.env.pruebas pruebas/probarTransacciones.js"
  },
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
