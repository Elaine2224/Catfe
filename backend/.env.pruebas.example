# Configuración SOLO para las pruebas. Copia este archivo como ".env.pruebas" y complétalo.
# (".env.pruebas" tampoco se sube a GitHub.)

# La MISMA conexión de Atlas que usas en .env, pero con otro nombre de base antes del "?":
# /catfe_pruebas en lugar de /catfe. Así las pruebas nunca tocan tus datos reales.
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CONTRASENA@TU_CLUSTER.mongodb.net/catfe_pruebas?retryWrites=true&w=majority

# Claves y usuarios que se crearán en la base de pruebas (pueden ser distintos a los reales)
JWT_SECRET=clave_solo_para_pruebas
ADMIN_USUARIO=admin
ADMIN_PASSWORD=admin_pruebas
CAJERO_USUARIO=cajero
CAJERO_PASSWORD=cajero_pruebas

# Opcional: puerto del servidor que las pruebas arrancan por su cuenta (por defecto 5055)
# PUERTO_PRUEBAS=5055
