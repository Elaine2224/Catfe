# Copia las líneas que te falten a tu archivo .env (el .env NO se comparte ni se sube a GitHub)

# Puerto donde corre el servidor
PORT=5000

# Enlace de MongoDB Atlas. Fíjate en el nombre de la base antes del "?": /catfe
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_CONTRASENA@TU_CLUSTER.mongodb.net/catfe?retryWrites=true&w=majority

# Clave secreta para firmar los tokens (puede ser cualquier texto largo)
JWT_SECRET=pon_aqui_una_clave_larga

# Administrador (lo crea seed.js)
ADMIN_USUARIO=admin
ADMIN_PASSWORD=cambia_esta_contrasena

# Cajero (lo crea seed.js)
CAJERO_USUARIO=cajero
CAJERO_PASSWORD=cambia_esta_otra_contrasena
